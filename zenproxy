replace_binary_atomic() {
  local source=$1 target=$2 temporary
  temporary=$(mktemp "$(dirname "$target")/.zenproxy-binary.XXXXXX") || return 1
  if ! install -m 0755 "$source" "$temporary" || ! mv -f "$temporary" "$target"; then
    rm -f "$temporary"
    return 1
  fi
}

update_state_manager_version() {
  local version=$1
  jq --arg version "$version" '.manager_version=$version' "$ZP_STATE_FILE" >"$ZP_STATE_FILE.tmp" && \
    chmod 0600 "$ZP_STATE_FILE.tmp" && mv "$ZP_STATE_FILE.tmp" "$ZP_STATE_FILE"
}

cmd_update() {
  require_root
  require_installed
  local rollback_dir staging_dir manager_file="" manager_sha256="" manager_version="" arg update_ok=0
  local current_xray current_cloudflared
  local target_xray_version=$XRAY_VERSION target_cloudflared_version=$CLOUDFLARED_VERSION metadata
  while (($#)); do
    arg=$1
    case "$arg" in
      --manager-file)
        (($# >= 2)) || die "--manager-file 缺少文件路径。"
        manager_file=$2; shift 2 ;;
      --manager-sha256)
        (($# >= 2)) || die "--manager-sha256 缺少摘要。"
        manager_sha256=${2,,}; shift 2 ;;
      --yes) ASSUME_YES=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      *) die "未知update选项：$arg" ;;
    esac
  done
  if [[ -n "$manager_file" || -n "$manager_sha256" ]]; then
    [[ -n "$manager_file" && "$manager_sha256" =~ ^[0-9a-f]{64}$ ]] || \
      die "更新管理器必须同时提供 --manager-file 和64位 --manager-sha256。"
    manager_file=$(readlink -f "$manager_file")
    [[ -f "$manager_file" ]] || die "管理器更新文件不存在。"
    [[ "$(sha256sum "$manager_file" | awk '{print $1}')" == "$manager_sha256" ]] || die "管理器更新文件摘要不匹配。"
    bash -n "$manager_file" || die "新管理器脚本语法无效。"
    manager_version=$(bash "$manager_file" version 2>/dev/null | awk '/^ZenProxy / {print $2; exit}')
    [[ -n "$manager_version" ]] || die "无法识别新管理器版本。"
    metadata=$(bash -c '
      source "$1"
      jq -n --arg xray "$XRAY_VERSION" --arg cloudflared "$CLOUDFLARED_VERSION" \
        "{xray:\$xray,cloudflared:\$cloudflared}"
    ' _ "$manager_file")
    target_xray_version=$(jq -er '.xray' <<<"$metadata") || die "无法读取新管理器的Xray版本。"
    target_cloudflared_version=$(jq -er '.cloudflared' <<<"$metadata") || die "无法读取新管理器的cloudflared版本。"
  fi
  current_xray=$($XRAY_BIN version 2>/dev/null | awk '/^Xray / {print $2; exit}' || true)
  current_cloudflared=$($CLOUDFLARED_BIN --version 2>/dev/null | awk '/cloudflared version/ {print $3; exit}' || true)
  log "更新计划：Xray ${current_xray:-未知} -> ${target_xray_version#v}；cloudflared ${current_cloudflared:-未知} -> ${target_cloudflared_version#v}。"
  [[ -z "$manager_file" ]] || log "同时更新ZenProxy管理器到 $manager_version。"
  if [[ "${current_xray#v}" == "${target_xray_version#v}" && \
        "${current_cloudflared#v}" == "${target_cloudflared_version#v}" && \
        -z "$manager_file" ]]; then
    ok "核心程序已经是目标版本，无需下载或重启。"
    return 0
  fi
  if (( DRY_RUN )); then
    log "将事务更新 Xray ${target_xray_version#v} 和 cloudflared ${target_cloudflared_version#v}。"
    [[ -n "$manager_file" ]] && log "同时更新 ZenProxy 管理器到 $manager_version。"
    return 0
  fi
  if [[ -t 0 ]] && ! confirm "确认下载并重启相关服务吗？"; then
    cancelled
    return 0
  fi
  acquire_lock
  rollback_dir=$(mktemp -d "$ZP_STATE_DIR/.update-rollback.XXXXXX")
  staging_dir=$(mktemp -d "$ZP_STATE_DIR/.update-staging.XXXXXX")
  cp -a "$ZP_BIN_DIR/." "$rollback_dir/"
  [[ -z "$manager_file" ]] || cp -a /usr/local/sbin/zenproxy "$rollback_dir/zenproxy-manager"
  info "下载并预检ZenProxy固定核心版本。"
  if ! (install_core_binaries "$staging_dir" "$target_xray_version" "$target_cloudflared_version"); then
    rm -rf -- "$rollback_dir" "$staging_dir"
    die "核心程序下载或校验失败，尚未替换任何文件。"
  fi
  if ! "$staging_dir/xray" run -test -config "$ZP_CONFIG_DIR/xray.json" || \
     ! "$staging_dir/cloudflared" --config "$ZP_CONFIG_DIR/cloudflared.yml" tunnel ingress validate >/dev/null; then
    rm -rf -- "$rollback_dir" "$staging_dir"
    die "新核心无法通过当前配置检查，尚未替换任何文件。"
  fi

  if replace_binary_atomic "$staging_dir/xray" "$XRAY_BIN" && \
     replace_binary_atomic "$staging_dir/cloudflared" "$CLOUDFLARED_BIN" && \
     { [[ -z "$manager_file" ]] || deploy_manager_command "$manager_file"; } && \
     systemctl restart "$XRAY_SERVICE" "$CLOUDFLARED_SERVICE"; then
    sleep 3
    if service_active "$XRAY_SERVICE" && service_active "$CLOUDFLARED_SERVICE"; then
      if [[ -z "$manager_version" ]] || update_state_manager_version "$manager_version"; then
        update_ok=1
      fi
    fi
  fi

  if (( ! update_ok )); then
    warn "更新提交或健康检查失败，正在回滚全部组件。"
    replace_binary_atomic "$rollback_dir/xray" "$XRAY_BIN" || true
    replace_binary_atomic "$rollback_dir/cloudflared" "$CLOUDFLARED_BIN" || true
    [[ ! -s "$rollback_dir/zenproxy-manager" ]] || deploy_manager_command "$rollback_dir/zenproxy-manager" || true
    systemctl restart "$XRAY_SERVICE" "$CLOUDFLARED_SERVICE" || true
    rm -rf -- "$rollback_dir" "$staging_dir"
    die "更新失败，已尝试恢复更新前版本。"
  fi
  rm -rf -- "$rollback_dir" "$staging_dir"
  ok "核心程序更新完成。"
  [[ -z "$manager_version" ]] || ok "ZenProxy管理器已更新到 $manager_version。"
}

safe_remove_tree() {
  local target=$1
  case "$target" in
    /etc/zenproxy|/var/lib/zenproxy|/usr/local/lib/zenproxy) rm -rf -- "$target" ;;
    *) die "拒绝删除非ZenProxy目录：$target" ;;
  esac
}

cmd_uninstall() {
  require_root
  require_installed
  acquire_lock
  local delete_tunnel=0 tunnel_id tunnel_name cf_home="" arg user
  local -a managed_users=()
  while (($#)); do
    arg=$1
    case "$arg" in
      --delete-tunnel) delete_tunnel=1 ;;
      --yes) ASSUME_YES=1 ;;
      --dry-run) DRY_RUN=1 ;;
      *) die "未知卸载选项：$arg" ;;
    esac
    shift
  done
  if (( DRY_RUN )); then
    log "将停止并删除ZenProxy的2个服务、配置、状态、二进制和专用用户。"
    (( delete_tunnel )) && log "同时删除Cloudflare Tunnel；DNS记录可能仍需在控制台处理。"
    return 0
  fi
  if (( ! delete_tunnel && ! ASSUME_YES )) && [[ -t 0 ]]; then
    if confirm "是否同时删除Cloudflare Tunnel？这需要再次进行浏览器授权。"; then
      delete_tunnel=1
    fi
  fi
  if (( delete_tunnel )); then
    warn "本次将删除本机配置、节点密钥和Cloudflare Tunnel。"
  else
    info "本次只删除本机内容，Cloudflare Tunnel和DNS记录将保留。"
  fi
  confirm "确认卸载ZenProxy吗？" || { cancelled; return 0; }
  tunnel_id=$(state_get '.tunnel_id')
  tunnel_name=$(state_get '.tunnel_name')
  mapfile -t managed_users < <(jq -r '.managed_users[]?' "$ZP_STATE_FILE")
  systemctl disable --now "$XRAY_SERVICE" "$CLOUDFLARED_SERVICE" 2>/dev/null || true
  rm -f "$ZP_SYSTEMD_DIR/$XRAY_SERVICE" "$ZP_SYSTEMD_DIR/$CLOUDFLARED_SERVICE"
  systemctl daemon-reload

  if (( delete_tunnel )); then
    cf_home=$(mktemp -d "$ZP_STATE_DIR/.cloudflare-delete.XXXXXX")
    install -d -m 0700 "$cf_home/.cloudflared"
    info "删除远程Tunnel需要临时进行一次Cloudflare浏览器授权。"
    if HOME="$cf_home" "$CLOUDFLARED_BIN" tunnel login && \
       HOME="$cf_home" "$CLOUDFLARED_BIN" tunnel delete -f "$tunnel_id"; then
      ok "Cloudflare Tunnel已删除。"
    else
      warn "Tunnel删除失败，请在Cloudflare控制台处理。"
    fi
    rm -rf -- "$cf_home"
    warn "DNS记录可能仍需在Cloudflare控制台删除。"
  else
    warn "Cloudflare Tunnel和DNS记录未删除。使用 --delete-tunnel 可同时删除Tunnel。"
  fi

  safe_remove_tree "$ZP_CONFIG_DIR"
  safe_remove_tree "$ZP_STATE_DIR"
  safe_remove_tree "$ZP_INSTALL_DIR"
  for user in "${managed_users[@]}"; do
    case "$user" in
      zenproxy-xray|zenproxy-cloudflared) userdel "$user" 2>/dev/null || true ;;
      *) warn "忽略状态文件中的未知用户：$user" ;;
    esac
  done
  rm -f /usr/local/sbin/zp /usr/local/sbin/zenproxy
  ok "ZenProxy已从本机卸载。"
}

menu_pause() {
  read -r -p "按回车返回主菜单..." _
}

interactive_menu() {
  local choice
  require_tty
  while true; do
    clear 2>/dev/null || true
    show_banner
    if is_installed; then
      cat <<'EOF'
1. 查看运行状态
2. 显示节点二维码
3. 一键检测
4. 导出客户端配置
5. 重启全部服务
6. 查看最近日志
7. 更新核心程序（会重启服务）
8. 卸载本机ZenProxy
0. 退出
EOF
    else
      cat <<'EOF'
1. 安装ZenProxy
0. 退出
EOF
    fi
    read -r -p "请选择: " choice
    if ! is_installed; then
      case "$choice" in
        1) cmd_install ;;
        0) return ;;
        *) warn "无效选项"; sleep 1 ;;
      esac
      continue
    fi
    case "$choice" in
      1) cmd_status; menu_pause ;;
      2) cmd_info --show-secrets; menu_pause ;;
      3) cmd_check || true; menu_pause ;;
      4) cmd_export; menu_pause ;;
      5) cmd_service_action restart all; menu_pause ;;
      6) cmd_logs all; menu_pause ;;
      7) cmd_update; menu_pause ;;
      8) cmd_uninstall; return ;;
      0) return ;;
      *) warn "无效选项"; sleep 1 ;;
    esac
  done
}

sudoer_whitelist_file="/etc/sudoers.d/zenproxy"

cmd_sudoer() {
  require_root
  local remove=0 arg
  while (($#)); do
    arg=$1
    case "$arg" in
      --remove|-r) remove=1 ;;
      *) die "未知sudoer选项：$arg" ;;
    esac
    shift
  done
  local user="${SUDO_USER:-$USER}"
  [[ -n "$user" ]] || die "无法确定当前用户。"
  if (( remove )); then
    rm -f "$sudoer_whitelist_file"
    ok "已移除 sudoers 白名单：$sudoer_whitelist_file"
    return 0
  fi
  printf '%s ALL=(root) NOPASSWD: /usr/local/sbin/zenproxy\n' "$user" >"$sudoer_whitelist_file"
  chmod 0440 "$sudoer_whitelist_file"
  if command -v visudo >/dev/null 2>&1; then
    visudo -cf "$sudoer_whitelist_file" >/dev/null 2>&1 || { rm -f "$sudoer_whitelist_file"; die "sudoers 语法校验失败，已回滚。"; }
  fi
  ok "已创建 sudoers 白名单：$sudoer_whitelist_file"
  info "用户 $user 现在可免密运行：sudo /usr/local/sbin/zenproxy 或 sudo zp"
  info "如需移除：sudo $(basename "$0") sudoer --remove"
}

main() {
  local command=${1:-}
  if [[ -z "$command" ]]; then
    require_root
    interactive_menu
    return
  fi
  shift || true
  case "$command" in
    install) cmd_install "$@" ;;
    status) cmd_status "$@" ;;
    check) cmd_check "$@" ;;
    info) cmd_info "$@" ;;
    export) cmd_export "$@" ;;
    start|stop|restart) cmd_service_action "$command" "$@" ;;
    logs) cmd_logs "${1:-all}" ;;
    update) cmd_update "$@" ;;
    sudoer) cmd_sudoer "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    version|--version|-v) log "ZenProxy $ZP_VERSION" ;;
    help|--help|-h) usage ;;
    *) usage; die "未知命令：$command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
