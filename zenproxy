write_singbox_export() {
  local output=$1 direct_ipv4 direct_ipv6 tunnel_domain reality_sni vless_port hy2_port
  local hy2_password uuid public_key short_id ws_path node_name
  direct_ipv4=$(stored_direct_ipv4); direct_ipv6=$(stored_direct_ipv6); tunnel_domain=$(state_get '.tunnel_domain')
  reality_sni=$(state_get '.reality_sni'); vless_port=$(state_get '.vless_port'); hy2_port=$(state_get '.hy2_port')
  hy2_password=$(read_secret "hysteria.password"); uuid=$(read_secret "vless.uuid")
  public_key=$(read_secret "reality.public-key"); short_id=$(read_secret "reality.short-id"); ws_path=$(read_secret "ws.path")
  node_name=$(state_get '.node_name')
  jq -n --arg direct_ipv4 "$direct_ipv4" --arg direct_ipv6 "$direct_ipv6" \
    --arg node_name "$node_name" \
    --arg tunnel "$tunnel_domain" --arg sni "$reality_sni" \
    --arg hy2_sni "$HY2_CERT_NAME" \
    --arg password "$hy2_password" --arg uuid "$uuid" --arg public_key "$public_key" \
    --arg short_id "$short_id" --arg ws_path "$ws_path" --rawfile hy2_certificate "$ZP_TLS_DIR/fullchain.pem" \
    --argjson vp "$vless_port" --argjson hp "$hy2_port" \
    'def direct_nodes($server;$suffix): [
       {type:"hysteria2",tag:(($node_name + "-hy2-" + $suffix)),server:$server,server_port:$hp,password:$password,
        tls:{enabled:true,server_name:$hy2_sni,
          certificate:($hy2_certificate | split("\n") | map(select(length > 0)))}},
       {type:"vless",tag:(($node_name + "-reality-" + $suffix)),server:$server,server_port:$vp,uuid:$uuid,flow:"xtls-rprx-vision",
        tls:{enabled:true,server_name:$sni,utls:{enabled:true,fingerprint:"chrome"},reality:{enabled:true,public_key:$public_key,short_id:$short_id}}}
     ];
     {outbounds: ([
       {type:"vless",tag:($node_name + "-cf"),server:$tunnel,server_port:443,uuid:$uuid,
        transport:{type:"ws",path:$ws_path,headers:{Host:$tunnel}},tls:{enabled:true,server_name:$tunnel}}
     ] + (if $direct_ipv4 == "" then [] else direct_nodes($direct_ipv4;"v4") end)
       + (if $direct_ipv6 == "" then [] else direct_nodes($direct_ipv6;"v6") end))}' >"$output"
}

cmd_export() {
  require_root
  require_installed
  local output="" arg parent base
  while (($#)); do
    arg=$1
    case "$arg" in
      --output)
        (($# >= 2)) || die "--output 缺少目录参数。"
        output=$2
        shift 2
        ;;
      *) die "未知export选项：$arg" ;;
    esac
  done
  output=${output:-"$PWD/zenproxy-client-$(date +%Y%m%d-%H%M%S)"}
  parent=$(dirname -- "$output")
  base=$(basename -- "$output")
  [[ "$base" != . && "$base" != .. && -n "$base" ]] || die "导出目录无效。"
  [[ -d "$parent" ]] || die "导出目录的上级目录不存在：$parent"
  [[ ! -e "$output" && ! -L "$output" ]] || die "导出目录已经存在，请指定一个新目录：$output"
  mkdir -m 0700 -- "$output"
  build_node_links
  {
    printf '%s\n' "$CF_LINK"
    [[ -z "$HY2_V4_LINK" ]] || printf '%s\n%s\n' "$HY2_V4_LINK" "$VLESS_V4_LINK"
    [[ -z "$HY2_V6_LINK" ]] || printf '%s\n%s\n' "$HY2_V6_LINK" "$VLESS_V6_LINK"
  } >"$output/nodes.txt"
  write_mihomo_export "$output/mihomo.yaml"
  write_singbox_export "$output/sing-box-outbounds.json"
  chmod 0600 "$output/nodes.txt" "$output/mihomo.yaml" "$output/sing-box-outbounds.json"
  real_user="${SUDO_USER:-$USER}"
  [[ -n "$real_user" ]] && chown -R "$real_user:" "$output"
  ok "客户端配置已导出到：$output"
}

check_command() {
  local success=$1 failure=$2
  shift 2
  if "$@"; then
    ok "$success"
  else
    warn "$failure"
    CHECK_FAILURES=$((CHECK_FAILURES + 1))
  fi
}

cmd_check() {
  require_root
  require_installed
  local direct_ipv4 direct_ipv6 tunnel_domain vless_port hy2_port current_ipv4 current_ipv6 ws_path
  CHECK_FAILURES=0
  direct_ipv4=$(stored_direct_ipv4); direct_ipv6=$(stored_direct_ipv6); tunnel_domain=$(state_get '.tunnel_domain')
  vless_port=$(state_get '.vless_port'); hy2_port=$(state_get '.hy2_port'); ws_path=$(read_secret "ws.path")
  show_banner
  check_command "Xray配置有效" "Xray配置无效" bash -c '"$1" run -test -config "$2" >/dev/null 2>&1' _ "$XRAY_BIN" "$ZP_CONFIG_DIR/xray.json"
  check_command "Xray服务正常" "Xray服务异常" service_active "$XRAY_SERVICE"
  check_command "Cloudflare Tunnel正常" "Cloudflare Tunnel异常" service_active "$CLOUDFLARED_SERVICE"
  check_command "Cloudflare公网主线路可达" "Cloudflare公网主线路无法完成WebSocket握手" \
    cloudflare_route_reachable "$tunnel_domain" "$ws_path"
  check_command "TCP $vless_port 正在监听" "TCP $vless_port 未监听" port_in_use tcp "$vless_port"
  check_command "UDP $hy2_port 正在监听" "UDP $hy2_port 未监听" port_in_use udp "$hy2_port"
  check_command "回环服务端口17122正在监听" "回环服务端口17122未监听" port_in_use tcp 17122
  check_command "REALITY协议握手正常" "REALITY协议握手失败，请运行 zp logs xray 查看详情" \
    reality_protocol_reachable "$vless_port"
  check_command "HY2协议握手正常" "HY2协议握手失败，请运行 zp logs xray 查看详情" \
    hy2_protocol_reachable "$hy2_port"
  check_command "HY2自签证书有效" "HY2自签证书无效" \
    openssl x509 -checkend $((30 * 86400)) -noout -in "$ZP_TLS_DIR/fullchain.pem"
  current_ipv4=$(public_ipv4 || true); current_ipv6=$(public_ipv6 || true)
  if [[ -n "$direct_ipv4" ]]; then
    if [[ -z "$current_ipv4" ]]; then
      warn "公网IPv4检测失败，无法判断地址是否变化"
      CHECK_FAILURES=$((CHECK_FAILURES + 1))
    elif [[ "$current_ipv4" == "$direct_ipv4" ]]; then
      ok "公网IPv4未变化"
    else
      warn "公网IPv4已变化，请重新安装以更新节点"
      CHECK_FAILURES=$((CHECK_FAILURES + 1))
    fi
  fi
  if [[ -n "$direct_ipv6" ]]; then
    if [[ -z "$current_ipv6" ]]; then
      warn "公网IPv6检测失败，无法判断地址是否变化"
      CHECK_FAILURES=$((CHECK_FAILURES + 1))
    elif [[ "$current_ipv6" == "$direct_ipv6" ]]; then
      ok "公网IPv6未变化"
    else
      warn "公网IPv6已变化，请重新安装以更新节点"
      CHECK_FAILURES=$((CHECK_FAILURES + 1))
    fi
  fi
  info "云厂商安全组无法从本机完整验证，请确认放行 TCP $vless_port 和 UDP $hy2_port。"
  if (( CHECK_FAILURES == 0 )); then ok "全部检查通过。"; else die "发现 $CHECK_FAILURES 项异常。"; fi
}

cmd_logs() {
