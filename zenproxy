deploy_manager_command() {
  local requested_source=$1 source_path temporary
  source_path=$(readlink -f "$requested_source")
  [[ -f "$source_path" ]] || return 1
  temporary=$(mktemp /usr/local/sbin/.zenproxy.XXXXXX) || return 1
  if ! install -m 0755 "$source_path" "$temporary" || \
     ! mv -f "$temporary" /usr/local/sbin/zenproxy || \
     ! ln -sfn /usr/local/sbin/zenproxy /usr/local/sbin/zp || \
     ! ln -sfn /usr/local/sbin/zenproxy /usr/local/bin/zp; then
    rm -f "$temporary"
    return 1
  fi
}

install_manager_command() {
  local replace=${1:-false} requested_source=${2:-${BASH_SOURCE[0]}}
  [[ -f "$(readlink -f "$requested_source")" ]] || \
    die "无法定位当前 ZenProxy 脚本，请先下载到本地文件再安装。"
  if [[ "$replace" != true ]]; then
    [[ ! -e /usr/local/sbin/zenproxy && ! -L /usr/local/sbin/zenproxy ]] || \
      die "拒绝覆盖已有命令：/usr/local/sbin/zenproxy"
    [[ ! -e /usr/local/sbin/zp && ! -L /usr/local/sbin/zp ]] || \
      die "拒绝覆盖已有命令：/usr/local/sbin/zp"
    [[ ! -e /usr/local/bin/zp && ! -L /usr/local/bin/zp ]] || \
      die "拒绝覆盖已有命令：/usr/local/bin/zp"
  fi
  deploy_manager_command "$requested_source" || die "无法安装ZenProxy管理命令。"
  MANAGER_COMMAND_INSTALLED=1
}

show_install_plan() {
  local tunnel_domain=$1 reality_sni=$2 vless_port=$3 hy2_port=$4 force_domain=${5:-0}
  local requested_ipv4=${6:-} requested_ipv6=${7:-} node_name=${8:-}
  cat <<EOF

安装计划
  直连IPv4：       ${requested_ipv4:-自动检测}
  直连IPv6：       ${requested_ipv6:-自动检测}
  Tunnel域名：     $tunnel_domain
  节点名称：       $node_name
  Cloudflare节点： ${node_name}-cf
  HY2节点：        ${node_name}-hy2-v4/v6
  REALITY节点：     ${node_name}-reality-v4/v6
  HY2证书：        本机自签 + 指纹固定
  REALITY目标：    $reality_sni:443
  VLESS监听：       TCP $vless_port
  Hysteria2监听：   UDP $hy2_port
  Cloudflare回源：  127.0.0.1:17122
  Cloudflare授权：  浏览器授权（无需Token）
EOF
  (( force_domain == 0 )) || log "注意：本次安装允许覆盖该域名已有的DNS记录。"
  if [[ "$vless_port" != 80 && "$vless_port" != 443 ]]; then
    log "TCP 80/443不会被ZenProxy占用，可用于Nginx或Caddy。"
  fi
  if [[ "$hy2_port" == 443 ]]; then
    log "注意：UDP 443用于HY2，不能同时用于Nginx/Caddy HTTP/3。"
  fi
}

cmd_install() {
  local tunnel_domain="" reality_sni="apple.com" direct_address direct_ipv4 direct_ipv6
  local node_name=""
  local requested_ipv4="" requested_ipv6=""
  local vless_port=8443 hy2_port=443
  local tunnel_name tunnel_id="" arg force_domain=0

  while (($#)); do
    arg=$1
    case "$arg" in
      --tunnel-domain|--node-name|--reality-sni|--vless-port|--hy2-port|--direct-ipv4|--direct-ipv6)
        (($# >= 2)) || die "$arg 缺少参数。"
        case "$arg" in
          --tunnel-domain) tunnel_domain=$2 ;;
          --node-name) node_name=$2 ;;
          --reality-sni) reality_sni=$2 ;;
          --vless-port) vless_port=$2 ;;
          --hy2-port) hy2_port=$2 ;;
          --direct-ipv4) requested_ipv4=$2 ;;
          --direct-ipv6) requested_ipv6=$2 ;;
        esac
        shift 2
        ;;
      --dry-run) DRY_RUN=1; shift ;;
      --yes) ASSUME_YES=1; shift ;;
      --force-domain) force_domain=1; shift ;;
      *) die "未知安装选项：$arg" ;;
    esac
  done

  if [[ -z "$tunnel_domain" ]]; then
    [[ -t 0 ]] || die "非交互安装必须指定 --tunnel-domain。"
    tunnel_domain=$(prompt_value "Cloudflare Tunnel子域名（例如 cf.example.com）")
  fi
  if [[ -z "$node_name" ]]; then
    [[ -t 0 ]] || die "非交互安装必须指定 --node-name。"
    node_name=$(prompt_value "节点名称（例如 us-la-01）")
  fi
  tunnel_domain=$(trim "${tunnel_domain,,}")
  reality_sni=$(trim "${reality_sni,,}")
  requested_ipv4=$(trim "$requested_ipv4")
  requested_ipv6=$(trim "$requested_ipv6")
  validate_domain "$tunnel_domain" || die "Tunnel域名格式不正确。"
  validate_node_name "$node_name" || die "节点名称无效，只允许中英文、数字、短横线和下划线，长度为1到32个字符。"
  validate_domain "$reality_sni" || die "REALITY目标域名格式不正确。"
  validate_port "$vless_port" || die "VLESS端口无效。"
  validate_port "$hy2_port" || die "HY2端口无效。"
  [[ -z "$requested_ipv4" ]] || valid_ipv4_address "$requested_ipv4" || die "手动指定的IPv4地址无效。"
  [[ -z "$requested_ipv6" ]] || valid_ipv6_address "$requested_ipv6" || die "手动指定的IPv6地址无效。"

  show_install_plan "$tunnel_domain" "$reality_sni" "$vless_port" "$hy2_port" "$force_domain" \
    "$requested_ipv4" "$requested_ipv6" "$node_name"
  if (( DRY_RUN )); then
    info "预演结束，没有修改系统。"
    return 0
  fi

  require_root
  acquire_lock
  check_platform
  is_installed && die "ZenProxy已经安装。"
  check_install_targets
  confirm "确认开始安装吗？" || { cancelled; return 0; }
  INSTALL_ACTIVE=1

  install_dependencies
  check_port_conflicts "$vless_port" "$hy2_port"
  direct_ipv4=${requested_ipv4:-$(public_ipv4 || true)}
  direct_ipv6=${requested_ipv6:-$(public_ipv6 || true)}
  [[ -n "$direct_ipv4" || -n "$direct_ipv6" ]] || die "无法检测本机公网 IP。"
  direct_address=${direct_ipv4:-$direct_ipv6}

  create_system_user zenproxy-xray
  create_system_user zenproxy-cloudflared
  prepare_directories
  install_core_binaries
  generate_credentials
  generate_self_signed_certificate

  tunnel_name="zenproxy-$(hostname -s | tr -cd '[:alnum:]-' | cut -c1-32)-$(openssl rand -hex 4)"
  write_state "$direct_address" "$direct_ipv4" "$direct_ipv6" "$tunnel_domain" "$reality_sni" \
    "pending" "$tunnel_name" "$vless_port" "$hy2_port" "$node_name"

  setup_cloudflare_tunnel "$tunnel_domain" "$tunnel_name" tunnel_id "$force_domain"
  [[ "$tunnel_id" =~ ^[0-9a-fA-F-]{36}$ ]] || die "Tunnel ID未正确写入安装状态。"
  write_state "$direct_address" "$direct_ipv4" "$direct_ipv6" "$tunnel_domain" "$reality_sni" \
    "$tunnel_id" "$tunnel_name" "$vless_port" "$hy2_port" "$node_name"

  write_xray_config "$reality_sni" "$vless_port" "$hy2_port"
  write_cloudflared_config "$tunnel_id" "$tunnel_domain"
  "$CLOUDFLARED_BIN" --config "$ZP_CONFIG_DIR/cloudflared.yml" tunnel ingress validate
  MANAGER_COMMAND_INSTALLED=1
  install_manager_command false "${BASH_SOURCE[0]}"
  UNITS_INSTALLED=1
  write_systemd_units

  systemctl enable --now "$XRAY_SERVICE" "$CLOUDFLARED_SERVICE"
  sleep 3
  service_active "$XRAY_SERVICE" || die "Xray启动失败，请查看日志。"
  port_in_use udp "$hy2_port" || die "Xray已启动，但Hysteria2 UDP端口未监听。"
  service_active "$CLOUDFLARED_SERVICE" || die "cloudflared启动失败，请查看日志。"

  rm -rf -- "$ZP_STATE_DIR/cloudflare-home"
  CREATED_TUNNEL_HOME=""
  INSTALL_ACTIVE=0
  ok "ZenProxy安装完成。"
  cmd_status
  log
  info "下一步：确认安全组放行 TCP $vless_port 和 UDP $hy2_port。"
  info "运行 sudo zp check 验证三条线路，运行 sudo zp info --clash 获取Mihomo节点。"
  log
  info "管理命令：sudo zp（已加入 PATH，无需记完整路径）"
  info "如需免除 sudo 密码：sudo zp sudoer"
}

all_services() {
  printf '%s\n' "$XRAY_SERVICE" "$CLOUDFLARED_SERVICE"
}

component_service() {
  case "$1" in
    all) printf 'all' ;;
    xray|vless|hy2|hysteria) printf '%s' "$XRAY_SERVICE" ;;
    cloudflared|cloudflare|tunnel) printf '%s' "$CLOUDFLARED_SERVICE" ;;
    *) die "未知组件：$1" ;;
  esac
}

cmd_service_action() {
  local action=$1 component=all service arg component_set=0
  shift
  while (($#)); do
    arg=$1
    case "$arg" in
      --dry-run) DRY_RUN=1 ;;
      -*) die "未知服务选项：$arg" ;;
      *) (( component_set == 0 )) || die "只能指定一个服务组件。"; component=$arg; component_set=1 ;;
    esac
    shift
  done
  require_root
  require_installed
  acquire_lock
  service=$(component_service "$component")
  if [[ "$service" == all ]]; then
    mapfile -t services < <(all_services)
    run systemctl "$action" "${services[@]}"
  else
    run systemctl "$action" "$service"
  fi
  ok "服务操作完成：$action $component"
}

route_status_line() {
  local label=$1 service=$2 protocol=$3 port=$4
  if service_active "$service" && port_in_use "$protocol" "$port"; then
    printf '%-22s %s正常%s\n' "$label" "$C_GREEN" "$C_RESET"
  else
    printf '%-22s %s异常%s\n' "$label" "$C_RED" "$C_RESET"
  fi
}

cloudflare_route_reachable() {
  local domain=$1 ws_path=$2 code
  code=$(curl --http1.1 -sS --connect-timeout 5 --max-time 5 -o /dev/null -w '%{http_code}' \
    -H 'Connection: Upgrade' \
    -H 'Upgrade: websocket' \
    -H 'Sec-WebSocket-Version: 13' \
    -H 'Sec-WebSocket-Key: MDEyMzQ1Njc4OWFiY2RlZg==' \
    "https://$domain$ws_path" 2>/dev/null || true)
  [[ "$code" == 101 ]]
}

random_check_port() {
  local candidate
  for candidate in $(shuf -i 20000-45000 -n 32); do
    if ! port_in_use tcp "$candidate"; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

local_proxy_protocol_test() {
  local config_file=$1 client_port=$2 client_pid result=1 attempt
  "$XRAY_BIN" run -config "$config_file" >/dev/null 2>&1 &
  client_pid=$!
  for attempt in {1..20}; do
    if port_in_use tcp "$client_port"; then
      break
    fi
    sleep 0.1
  done
  if port_in_use tcp "$client_port" && \
     curl --noproxy '*' --proxy "socks5h://127.0.0.1:$client_port" \
       --connect-timeout 3 --max-time 8 -sS -o /dev/null \
       "http://127.0.0.1:17122/"; then
    result=0
  fi
  kill "$client_pid" >/dev/null 2>&1 || true
  wait "$client_pid" >/dev/null 2>&1 || true
  return "$result"
}

reality_protocol_reachable() {
  local vless_port=$1 client_port config_file uuid public_key short_id reality_sni result
  client_port=$(random_check_port) || return 1
  config_file=$(mktemp "$ZP_STATE_DIR/.check-reality.XXXXXX.json") || return 1
  uuid=$(read_secret "vless.uuid")
  public_key=$(read_secret "reality.public-key")
  short_id=$(read_secret "reality.short-id")
  reality_sni=$(state_get '.reality_sni')
  jq -n --arg uuid "$uuid" --arg public_key "$public_key" --arg short_id "$short_id" \
    --arg sni "$reality_sni" --argjson server_port "$vless_port" --argjson client_port "$client_port" \
    '{log:{loglevel:"error"},inbounds:[{listen:"127.0.0.1",port:$client_port,protocol:"socks",settings:{auth:"noauth",udp:false}}],outbounds:[{protocol:"vless",settings:{vnext:[{address:"127.0.0.1",port:$server_port,users:[{id:$uuid,encryption:"none",flow:"xtls-rprx-vision"}]}]},streamSettings:{network:"raw",security:"reality",realitySettings:{serverName:$sni,fingerprint:"chrome",publicKey:$public_key,shortId:$short_id}}}]}' >"$config_file"
  chmod 0600 "$config_file"
  if local_proxy_protocol_test "$config_file" "$client_port"; then
    result=0
  else
    result=$?
  fi
  rm -f -- "$config_file"
  return "$result"
}

hy2_protocol_reachable() {
  local hy2_port=$1 client_port config_file password fingerprint result
  client_port=$(random_check_port) || return 1
  config_file=$(mktemp "$ZP_STATE_DIR/.check-hy2.XXXXXX.json") || return 1
  password=$(read_secret "hysteria.password")
  fingerprint=$(read_secret "tls.fingerprint")
  jq -n --arg password "$password" --arg fingerprint "$fingerprint" \
    --argjson server_port "$hy2_port" --argjson client_port "$client_port" \
    '{log:{loglevel:"error"},inbounds:[{listen:"127.0.0.1",port:$client_port,protocol:"socks",settings:{auth:"noauth",udp:false}}],outbounds:[{protocol:"hysteria",settings:{version:2,address:"127.0.0.1",port:$server_port},streamSettings:{network:"hysteria",security:"tls",tlsSettings:{serverName:"www.bing.com",pinnedPeerCertSha256:$fingerprint},hysteriaSettings:{version:2,auth:$password}}}]}' >"$config_file"
  chmod 0600 "$config_file"
  if local_proxy_protocol_test "$config_file" "$client_port"; then
    result=0
  else
    result=$?
  fi
  rm -f -- "$config_file"
  return "$result"
}

cmd_status() {
  require_installed
  local direct_ipv4 direct_ipv6 tunnel_domain vless_port hy2_port node_name
  direct_ipv4=$(stored_direct_ipv4)
  direct_ipv6=$(stored_direct_ipv6)
  tunnel_domain=$(state_get '.tunnel_domain')
  vless_port=$(state_get '.vless_port')
  hy2_port=$(state_get '.hy2_port')
  node_name=$(state_get '.node_name')
  [[ -n "$node_name" ]] || die "安装状态缺少节点名称，请重新安装。"
  show_banner
  if service_active "$CLOUDFLARED_SERVICE" && port_in_use tcp 17122; then
    printf '%-22s %s本机正常%s\n' "Cloudflare本地组件" "$C_GREEN" "$C_RESET"
  else
    printf '%-22s %s本机异常%s\n' "Cloudflare本地组件" "$C_RED" "$C_RESET"
  fi
  route_status_line "HY2本机监听" "$XRAY_SERVICE" udp "$hy2_port"
  route_status_line "REALITY本机监听" "$XRAY_SERVICE" tcp "$vless_port"
  printf '%-22s UDP %s\n' "HY2端口" "$hy2_port"
  printf '%-22s TCP %s\n' "VLESS端口" "$vless_port"
  [[ -z "$direct_ipv4" ]] || printf '%-22s %s\n' "直连IPv4" "$direct_ipv4"
  [[ -z "$direct_ipv6" ]] || printf '%-22s %s\n' "直连IPv6" "$direct_ipv6"
  printf '%-22s %s\n' "Tunnel域名" "$tunnel_domain"
  printf '%-22s %s\n' "节点名称" "$node_name"
  printf '%-22s %s\n' "HY2证书" "自签证书（指纹固定）"
  info "公网线路请运行：sudo zp check"
}

build_node_links() {
  local direct_ipv4 direct_ipv6 direct_host tunnel_domain reality_sni vless_port hy2_port
  local hy2_password vless_uuid public_key short_id ws_path encoded_path fingerprint
  direct_ipv4=$(stored_direct_ipv4)
  direct_ipv6=$(stored_direct_ipv6)
  tunnel_domain=$(state_get '.tunnel_domain')
  reality_sni=$(state_get '.reality_sni')
  vless_port=$(state_get '.vless_port')
  hy2_port=$(state_get '.hy2_port')
  hy2_password=$(read_secret "hysteria.password")
  vless_uuid=$(read_secret "vless.uuid")
  public_key=$(read_secret "reality.public-key")
  short_id=$(read_secret "reality.short-id")
  ws_path=$(read_secret "ws.path")
  fingerprint=$(read_secret "tls.fingerprint")
  encoded_path=${ws_path/\//%2F}
  [[ -n "$(state_get '.node_name')" ]] || die "安装状态缺少节点名称，请重新安装。"

  CF_LINK="vless://${vless_uuid}@${tunnel_domain}:443?encryption=none&security=tls&sni=${tunnel_domain}&fp=chrome&type=ws&host=${tunnel_domain}&path=${encoded_path}#$(uri_fragment_name cf)"
  HY2_V4_LINK="" VLESS_V4_LINK="" HY2_V6_LINK="" VLESS_V6_LINK=""
  if [[ -n "$direct_ipv4" ]]; then
    direct_host=$(uri_host "$direct_ipv4")
    HY2_V4_LINK="hysteria2://${hy2_password}@${direct_host}:${hy2_port}/?sni=${HY2_CERT_NAME}&alpn=h3&pinSHA256=${fingerprint}#$(uri_fragment_name hy2 v4)"
    VLESS_V4_LINK="vless://${vless_uuid}@${direct_host}:${vless_port}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${reality_sni}&fp=chrome&pbk=${public_key}&sid=${short_id}&type=tcp&headerType=none#$(uri_fragment_name reality v4)"
  fi
  if [[ -n "$direct_ipv6" ]]; then
    direct_host=$(uri_host "$direct_ipv6")
    HY2_V6_LINK="hysteria2://${hy2_password}@${direct_host}:${hy2_port}/?sni=${HY2_CERT_NAME}&alpn=h3&pinSHA256=${fingerprint}#$(uri_fragment_name hy2 v6)"
    VLESS_V6_LINK="vless://${vless_uuid}@${direct_host}:${vless_port}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${reality_sni}&fp=chrome&pbk=${public_key}&sid=${short_id}&type=tcp&headerType=none#$(uri_fragment_name reality v6)"
  fi
}

