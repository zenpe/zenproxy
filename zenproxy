#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly ZP_VERSION="0.4.2"
readonly XRAY_VERSION="v26.3.27"
readonly CLOUDFLARED_VERSION="2026.8.1"
readonly HY2_CERT_NAME="www.bing.com"

readonly ZP_CONFIG_DIR="${ZENPROXY_CONFIG_DIR:-/etc/zenproxy}"
readonly ZP_CREDENTIAL_DIR="$ZP_CONFIG_DIR/credentials"
readonly ZP_TLS_DIR="$ZP_CONFIG_DIR/tls"
readonly ZP_STATE_DIR="${ZENPROXY_STATE_DIR:-/var/lib/zenproxy}"
readonly ZP_STATE_FILE="$ZP_STATE_DIR/state.json"
readonly ZP_INSTALL_DIR="${ZENPROXY_INSTALL_DIR:-/usr/local/lib/zenproxy}"
readonly ZP_BIN_DIR="$ZP_INSTALL_DIR/bin"
readonly ZP_SYSTEMD_DIR="${ZENPROXY_SYSTEMD_DIR:-/etc/systemd/system}"
readonly ZP_LOCK_FILE="${ZENPROXY_LOCK_FILE:-/run/lock/zenproxy.lock}"

readonly XRAY_BIN="$ZP_BIN_DIR/xray"
readonly CLOUDFLARED_BIN="$ZP_BIN_DIR/cloudflared"
readonly XRAY_SERVICE="zenproxy-xray.service"
readonly CLOUDFLARED_SERVICE="zenproxy-cloudflared.service"

DRY_RUN=0
ASSUME_YES=0
SHOW_SECRETS=0
INSTALL_ACTIVE=0
MANAGER_COMMAND_INSTALLED=0
UNITS_INSTALLED=0
CREATED_TUNNEL_ID=""
CREATED_TUNNEL_HOME=""
CREATED_USERS=()

if [[ -t 1 ]]; then
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_BOLD="" C_RESET=""
fi

log() { printf '%s\n' "$*"; }
info() { printf '%s[信息]%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok() { printf '%s[正常]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s[注意]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die() { printf '%s[错误]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

quote_cmd() {
  local arg
  printf '+'
  for arg in "$@"; do printf ' %q' "$arg"; done
  printf '\n'
}

run() {
  if (( DRY_RUN )); then
    quote_cmd "$@"
    return 0
  fi
  "$@"
}

command_exists() { command -v "$1" >/dev/null 2>&1; }

require_root() {
  (( EUID == 0 )) || die "该操作需要 root 权限，请使用 sudo。"
}

acquire_lock() {
  command_exists flock || die "缺少 flock，请安装 util-linux。"
  mkdir -p "$(dirname "$ZP_LOCK_FILE")"
  exec 9>"$ZP_LOCK_FILE"
  flock -n 9 || die "另一个 ZenProxy 操作正在运行。"
}

is_installed() { [[ -s "$ZP_STATE_FILE" ]]; }

require_installed() {
  is_installed || die "ZenProxy 尚未安装，请先运行：sudo zenproxy install"
}

state_get() {
  local expression=$1
  jq -er "$expression" "$ZP_STATE_FILE"
}

stored_direct_ipv4() {
  jq -r '.direct_ipv4 // (if (.direct_address | contains(":")) then "" else .direct_address end)' "$ZP_STATE_FILE"
}

stored_direct_ipv6() {
  jq -r '.direct_ipv6 // (if (.direct_address | contains(":")) then .direct_address else "" end)' "$ZP_STATE_FILE"
}

trim() {
  local value=$1
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

validate_domain() {
  local domain=${1,,}
  [[ ${#domain} -le 253 ]] || return 1
  [[ "$domain" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]]
}

validate_node_name() {
  local name=$1
  [[ "$name" =~ ^[[:alnum:]_-]{1,32}$ ]]
}

node_proxy_name() {
  local node_name protocol family
  node_name=$(state_get '.node_name')
  protocol=$1
  family=${2:-}
  if [[ -n "$family" ]]; then
    printf '%s-%s-%s' "$node_name" "$protocol" "$family"
  else
    printf '%s-%s' "$node_name" "$protocol"
  fi
}

validate_port() {
  local port=$1
  [[ "$port" =~ ^[1-9][0-9]*$ && ${#port} -le 5 ]] && (( 10#$port <= 65535 ))
}

require_tty() {
  [[ -t 0 ]] || die "需要交互输入，但标准输入不是终端（可能通过 curl | bash 管道运行）。\n  交互使用：请在本机终端运行（sudo）zp。\n  非交互使用：为所需参数显式传值并加 --yes。"
}

prompt_value() {
  local prompt=$1 default=${2:-} result
  require_tty
  if [[ -n "$default" ]]; then
    read -r -p "$prompt [$default]: " result
    result=${result:-$default}
  else
    read -r -p "$prompt: " result
  fi
  trim "$result"
}

confirm() {
  local prompt=$1 answer
  (( ASSUME_YES )) && return 0
  require_tty
  read -r -p "$prompt [y/N]: " answer
  [[ "$answer" =~ ^([Yy]|[Yy][Ee][Ss]|是)$ ]]
}

cancelled() {
  info "操作已取消。"
  return 0
}

mask_secret() {
  local value=$1 length=${#1}
  if (( length <= 8 )); then
    printf '********'
  else
    printf '%s...%s' "${value:0:4}" "${value:length-4:4}"
  fi
}

random_urlsafe() {
  local bytes=${1:-24}
  openssl rand -base64 "$bytes" | tr '+/' '-_' | tr -d '=\n'
}

architecture() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'amd64' ;;
    aarch64|arm64) printf 'arm64' ;;
    *) die "暂不支持 CPU 架构：$(uname -m)" ;;
  esac
}

service_active() {
  systemctl is-active --quiet "$1"
}

port_in_use() {
  local protocol=$1 port=$2
  if [[ "$protocol" == tcp ]]; then
    ss -H -lnt | awk -v port=":$port" '$4 ~ (port "$") { found=1 } END { exit !found }'
  else
    ss -H -lnu | awk -v port=":$port" '$4 ~ (port "$") { found=1 } END { exit !found }'
  fi
}

show_banner() {
  printf '%sZenProxy%s %s\n' "$C_BOLD" "$C_RESET" "$ZP_VERSION"
  printf 'Cloudflare主线路 + HY2/REALITY直连备用\n\n'
}

usage() {
  cat <<'EOF'
用法：zenproxy <命令> [选项]

命令：
  install       全新安装
  status        查看服务和端口状态
  check         执行一键诊断
  info          查看节点信息
  export        导出分享链接、Mihomo和sing-box配置
  start         启动全部服务
  stop          停止全部服务
  restart       重启全部服务或指定组件
  logs [组件]   查看最近日志（xray或cloudflared）
  update        事务更新核心程序及可选管理器
  uninstall     卸载本机 ZenProxy
  sudoer        生成/移除当前用户免密 sudo 白名单
  version       显示版本

常用选项：
  --dry-run             只显示计划，不执行变更
  --yes                 跳过普通确认
  --show-secrets        显示完整节点链接
  --clash               info输出Mihomo/Clash.Meta节点YAML
  --tunnel-domain NAME  Cloudflare Tunnel域名
  --node-name NAME      客户端节点名称（支持中英文，必须唯一）
  --vless-port PORT     VLESS TCP端口，默认8443
  --hy2-port PORT       HY2 UDP端口，默认443
  --direct-ipv4 ADDR    手动指定直连IPv4地址
  --direct-ipv6 ADDR    手动指定直连IPv6地址
  --force-domain        明确允许覆盖已有Tunnel域名
  --delete-tunnel       uninstall时同时删除Cloudflare Tunnel（需要浏览器授权）
  --output DIR           export输出到指定的新目录
  --manager-file FILE   update时同时安装新的管理器脚本
  --manager-sha256 HASH 新管理器脚本的SHA256摘要

不带命令运行时进入中文菜单。简写命令：zp
EOF
}

on_error() {
  local exit_code=$? line=${BASH_LINENO[0]:-unknown}
  printf '%s[失败]%s 第 %s 行执行失败，退出码 %s。命令: %s\n' "$C_RED" "$C_RESET" "$line" "$exit_code" "${BASH_COMMAND:-}" >&2
  if (( INSTALL_ACTIVE )); then
    warn "安装未完成，将回滚本次创建的本地资源和Tunnel。"
  fi
  exit "$exit_code"
}

cleanup_partial_install() {
  local user
  set +e
  if (( UNITS_INSTALLED )); then
    systemctl disable --now "$XRAY_SERVICE" "$CLOUDFLARED_SERVICE" >/dev/null 2>&1
    rm -f "$ZP_SYSTEMD_DIR/$XRAY_SERVICE" "$ZP_SYSTEMD_DIR/$CLOUDFLARED_SERVICE"
    systemctl daemon-reload >/dev/null 2>&1
  fi
  if [[ -n "$CREATED_TUNNEL_ID" && -x "$CLOUDFLARED_BIN" && -d "$CREATED_TUNNEL_HOME" ]]; then
    HOME="$CREATED_TUNNEL_HOME" "$CLOUDFLARED_BIN" tunnel delete -f "$CREATED_TUNNEL_ID" >/dev/null 2>&1 || true
  fi
  [[ "$ZP_CONFIG_DIR" == /etc/zenproxy ]] && rm -rf -- "$ZP_CONFIG_DIR"
  [[ "$ZP_STATE_DIR" == /var/lib/zenproxy ]] && rm -rf -- "$ZP_STATE_DIR"
  [[ "$ZP_INSTALL_DIR" == /usr/local/lib/zenproxy ]] && rm -rf -- "$ZP_INSTALL_DIR"
  for user in "${CREATED_USERS[@]}"; do
    userdel "$user" >/dev/null 2>&1
  done
  if (( MANAGER_COMMAND_INSTALLED )); then
    rm -f /usr/local/sbin/zp /usr/local/sbin/zenproxy /usr/local/bin/zp
  fi
  set -e
}

on_exit() {
  local exit_code=$1
  if (( INSTALL_ACTIVE )); then
    warn "安装失败，正在清理ZenProxy本地文件。"
    cleanup_partial_install
    warn "已尝试删除本次创建的Tunnel；请在Cloudflare控制台确认DNS记录。"
  fi
  return "$exit_code"
}

trap on_error ERR
trap 'on_exit $?' EXIT

validate_platform_version() {
  local distribution=$1 version=$2 major minor
  major=${version%%.*}
  minor=${version#*.}
  minor=${minor%%.*}
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  major=$((10#$major))
  minor=$((10#$minor))
  case "$distribution" in
    debian) (( major >= 12 )) ;;
    ubuntu) (( major > 22 || (major == 22 && minor >= 4) )) ;;
    *) return 1 ;;
  esac
}

check_platform() {
  [[ "$(uname -s)" == Linux ]] || die "ZenProxy 仅支持 Linux。"
  command_exists systemctl || die "当前系统没有 systemd。"
  [[ -d /run/systemd/system ]] || die "当前系统未运行 systemd。"
  [[ -r /etc/os-release ]] || die "无法识别操作系统。"
  # shellcheck disable=SC1091
  . /etc/os-release
  validate_platform_version "${ID:-}" "${VERSION_ID:-}" || \
    die "第一版仅支持 Debian 12+ 和 Ubuntu 22.04+。当前系统：${PRETTY_NAME:-未知}"
  architecture >/dev/null
}

install_dependencies() {
  info "安装基础依赖"
  run env DEBIAN_FRONTEND=noninteractive apt-get update
  run env DEBIAN_FRONTEND=noninteractive apt-get install -y \
    ca-certificates curl iproute2 jq openssl qrencode unzip util-linux
}

github_asset_metadata() {
  local repository=$1 tag=$2 asset=$3 encoded_tag response
  encoded_tag=$(printf '%s' "$tag" | jq -sRr @uri)
  response=$(curl -fsSL --retry 3 --connect-timeout 10 \
    "https://api.github.com/repos/$repository/releases/tags/$encoded_tag")
  jq -er --arg asset "$asset" \
    '.assets[] | select(.name == $asset) | {url:.browser_download_url,digest:(.digest // "")}' \
    <<<"$response"
}

download_github_asset() {
  local repository=$1 tag=$2 asset=$3 destination=$4 metadata url digest expected actual temporary
  metadata=$(github_asset_metadata "$repository" "$tag" "$asset") || \
    die "找不到官方发布文件：$repository $tag $asset"
  url=$(jq -er '.url' <<<"$metadata")
  digest=$(jq -r '.digest' <<<"$metadata")
  [[ "$digest" == sha256:* ]] || \
    die "GitHub未提供 $asset 的SHA256摘要，已拒绝不校验下载。"
  expected=${digest#sha256:}
  temporary=$(mktemp "$ZP_STATE_DIR/.download.XXXXXX")
  curl -fL --retry 3 --connect-timeout 10 --output "$temporary" "$url"
  actual=$(sha256sum "$temporary" | awk '{print $1}')
  [[ "$actual" == "$expected" ]] || {
    rm -f "$temporary"
    die "$asset 校验失败。"
  }
  install -m 0755 "$temporary" "$destination"
  rm -f "$temporary"
}

install_core_binaries() {
  local target_dir=${1:-$ZP_BIN_DIR} xray_version=${2:-$XRAY_VERSION}
  local cloudflared_version=${3:-$CLOUDFLARED_VERSION} arch xray_asset archive unpack_dir
  arch=$(architecture)
  install -d -m 0755 "$ZP_INSTALL_DIR" "$target_dir"
  install -d -m 0750 "$ZP_STATE_DIR"

  case "$arch" in
    amd64) xray_asset="Xray-linux-64.zip" ;;
    arm64) xray_asset="Xray-linux-arm64-v8a.zip" ;;
  esac

  info "下载并校验 Xray $xray_version"
  archive=$(mktemp "$ZP_STATE_DIR/.xray.XXXXXX.zip")
  download_github_asset "XTLS/Xray-core" "$xray_version" "$xray_asset" "$archive"
  unpack_dir=$(mktemp -d "$ZP_STATE_DIR/.xray-unpack.XXXXXX")
  unzip -q "$archive" xray -d "$unpack_dir"
  install -m 0755 "$unpack_dir/xray" "$target_dir/xray"
  rm -rf "$archive" "$unpack_dir"

  info "下载并校验 cloudflared $cloudflared_version"
  download_github_asset "cloudflare/cloudflared" "$cloudflared_version" \
    "cloudflared-linux-$arch" "$target_dir/cloudflared"

  local version_text
  version_text=$("$target_dir/xray" version)
  printf '%s\n' "${version_text%%$'\n'*}"
  version_text=$("$target_dir/cloudflared" --version)
  printf '%s\n' "${version_text%%$'\n'*}"
}

create_system_user() {
  local user=$1
  getent passwd "$user" >/dev/null && \
    die "系统用户 $user 已存在，无法确认其归属。请先检查同名服务或残留安装。"
  run useradd --system --user-group --home-dir /nonexistent --shell /usr/sbin/nologin "$user"
  CREATED_USERS+=("$user")
}

check_install_targets() {
  local target
  for target in "$ZP_CONFIG_DIR" "$ZP_STATE_DIR" "$ZP_INSTALL_DIR" \
    /usr/local/sbin/zenproxy /usr/local/sbin/zp \
    "$ZP_SYSTEMD_DIR/$XRAY_SERVICE" "$ZP_SYSTEMD_DIR/$CLOUDFLARED_SERVICE"; do
    [[ ! -e "$target" && ! -L "$target" ]] || die "检测到已有路径，拒绝覆盖：$target"
  done
  check_install_users
}

check_install_users() {
  local user
  for user in zenproxy-xray zenproxy-cloudflared; do
    if getent passwd "$user" >/dev/null; then
      die "检测到已有系统用户，拒绝复用：$user"
    fi
  done
}

prepare_directories() {
  install -d -m 0755 -o root -g root "$ZP_CONFIG_DIR"
  install -d -m 0750 -o root -g root "$ZP_STATE_DIR"
  install -d -m 0711 -o root -g root "$ZP_CREDENTIAL_DIR"
  install -d -m 0750 -o root -g zenproxy-xray "$ZP_TLS_DIR"
}

write_secret() {
  local name=$1 value=$2 group=${3:-root}
  printf '%s\n' "$value" >"$ZP_CREDENTIAL_DIR/$name"
  chown root:"$group" "$ZP_CREDENTIAL_DIR/$name"
  chmod 0640 "$ZP_CREDENTIAL_DIR/$name"
}

read_secret() {
  local name=$1
  tr -d '\r\n' <"$ZP_CREDENTIAL_DIR/$name"
}

generate_credentials() {
  local key_pair private_key public_key uuid hy2_password short_id ws_path
  uuid=$($XRAY_BIN uuid)
  key_pair=$($XRAY_BIN x25519)
  private_key=$(awk -F: '/PrivateKey/ {gsub(/[[:space:]]/, "", $2); print $2}' <<<"$key_pair")
  public_key=$(awk -F: '/PublicKey|Password/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' <<<"$key_pair")
  [[ -n "$private_key" && -n "$public_key" ]] || die "无法生成 REALITY 密钥。"
  hy2_password=$(random_urlsafe 24)
  short_id=$(openssl rand -hex 8)
  ws_path="/$(random_urlsafe 18)"

  write_secret "vless.uuid" "$uuid" zenproxy-xray
  write_secret "reality.private-key" "$private_key" zenproxy-xray
  write_secret "reality.public-key" "$public_key"
  write_secret "reality.short-id" "$short_id" zenproxy-xray
  write_secret "hysteria.password" "$hy2_password" zenproxy-xray
  write_secret "ws.path" "$ws_path" zenproxy-xray
}

valid_ipv4_address() {
  local address=$1 octet
  local -a octets=()
  local IFS=.
  read -r -a octets <<<"$address"
  ((${#octets[@]} == 4)) || return 1
  for octet in "${octets[@]}"; do
    [[ "$octet" =~ ^[0-9]{1,3}$ ]] && (( 10#$octet <= 255 )) || return 1
  done
}

valid_ipv6_address() {
  local address=$1 resolved
  [[ "$address" == *:* && "$address" =~ ^[0-9a-fA-F:]+$ ]] || return 1
  resolved=$(getent ahosts "$address" 2>/dev/null | awk 'NR == 1 {print $1}')
  [[ "$resolved" == *:* ]]
}

public_ipv4() {
  local endpoint address
  for endpoint in https://api.ipify.org https://icanhazip.com https://ifconfig.co/ip; do
    address=$(curl -4fsS --max-time 8 "$endpoint" 2>/dev/null | tr -d '[:space:]' || true)
    if valid_ipv4_address "$address"; then
      printf '%s' "$address"
      return 0
    fi
  done
  return 1
}

public_ipv6() {
  local endpoint address
  for endpoint in https://api6.ipify.org https://icanhazip.com https://ifconfig.co/ip; do
    address=$(curl -6fsS --max-time 8 "$endpoint" 2>/dev/null | tr -d '[:space:]' || true)
    if valid_ipv6_address "$address"; then
      printf '%s' "$address"
      return 0
    fi
  done
  return 1
}

ipv6_dual_stack_available() {
  [[ -s /proc/net/if_inet6 ]] || return 1
  [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || printf '1')" == 0 ]] || return 1
  [[ "$(cat /proc/sys/net/ipv6/bindv6only 2>/dev/null || printf '1')" == 0 ]]
}

inbound_listen_address() {
  if ipv6_dual_stack_available; then
    printf '::'
  else
    printf '0.0.0.0'
  fi
}

uri_host() {
  local address=$1
  if [[ "$address" == *:* ]]; then
    printf '[%s]' "$address"
  else
    printf '%s' "$address"
  fi
}

uri_fragment_name() {
  local name
  name=$(node_proxy_name "$@")
  jq -nr --arg value "$name" '$value | @uri'
}

check_port_conflicts() {
  local vless_port=$1 hy2_port=$2 conflict=0
  if port_in_use tcp "$vless_port"; then warn "TCP $vless_port 已被占用。"; conflict=1; fi
  if port_in_use udp "$hy2_port"; then warn "UDP $hy2_port 已被占用。"; conflict=1; fi
  if port_in_use tcp 17122; then warn "TCP 17122 已被占用。"; conflict=1; fi
  (( conflict == 0 )) || die "请先处理端口冲突。ZenProxy不会停止或修改现有服务。"
}

generate_self_signed_certificate() {
  info "生成HY2自签证书和固定指纹"
  openssl ecparam -genkey -name prime256v1 -out "$ZP_TLS_DIR/privkey.pem"
  openssl req -new -x509 -sha256 -days 3650 \
    -key "$ZP_TLS_DIR/privkey.pem" \
    -out "$ZP_TLS_DIR/fullchain.pem" \
    -subj "/CN=$HY2_CERT_NAME" \
    -addext "subjectAltName=DNS:$HY2_CERT_NAME"
  chown root:zenproxy-xray "$ZP_TLS_DIR/privkey.pem" "$ZP_TLS_DIR/fullchain.pem"
  chmod 0640 "$ZP_TLS_DIR/privkey.pem" "$ZP_TLS_DIR/fullchain.pem"
  openssl x509 -in "$ZP_TLS_DIR/fullchain.pem" -outform DER | \
    sha256sum | awk '{print $1}' >"$ZP_CREDENTIAL_DIR/tls.fingerprint"
  chown root:root "$ZP_CREDENTIAL_DIR/tls.fingerprint"
  chmod 0640 "$ZP_CREDENTIAL_DIR/tls.fingerprint"
}

setup_cloudflare_tunnel() {
  local tunnel_domain=$1 tunnel_name=$2 result_variable=$3 force_domain=${4:-0}
  local cf_home created_tunnel_id source_credential
  cf_home="$ZP_STATE_DIR/cloudflare-home"
  install -d -m 0700 "$cf_home/.cloudflared"

  info "接下来需要浏览器授权：请打开终端显示的链接，选择托管该子域名的根域名，授权完成后回到此终端。"
  info "不需要预先创建DNS记录或提供Tunnel Token；每台VPS请使用不同的子域名。"
  HOME="$cf_home" "$CLOUDFLARED_BIN" tunnel login
  HOME="$cf_home" "$CLOUDFLARED_BIN" tunnel create "$tunnel_name"
  created_tunnel_id=$(HOME="$cf_home" "$CLOUDFLARED_BIN" tunnel list --output json | \
    jq -er --arg name "$tunnel_name" '[.[] | select(.name == $name)] | last | .id')
  [[ "$created_tunnel_id" =~ ^[0-9a-fA-F-]{36}$ ]] || die "无法取得 Cloudflare Tunnel ID。"
  CREATED_TUNNEL_ID=$created_tunnel_id
  CREATED_TUNNEL_HOME=$cf_home
  if (( force_domain )); then
    warn "正在按用户要求覆盖已有DNS记录：$tunnel_domain"
    HOME="$cf_home" "$CLOUDFLARED_BIN" tunnel route dns --overwrite-dns \
      "$created_tunnel_id" "$tunnel_domain"
  elif ! HOME="$cf_home" "$CLOUDFLARED_BIN" tunnel route dns \
      "$created_tunnel_id" "$tunnel_domain"; then
    warn "Tunnel域名可能已经被其他Tunnel或DNS记录使用：$tunnel_domain"
    warn "请为每台VPS使用不同子域名；确认需要接管时才使用 --force-domain。"
    return 1
  fi

  source_credential="$cf_home/.cloudflared/$created_tunnel_id.json"
  [[ -s "$source_credential" ]] || die "Cloudflare Tunnel凭据文件不存在。"
  install -m 0640 "$source_credential" "$ZP_CREDENTIAL_DIR/cloudflared.json"
  chown root:zenproxy-cloudflared "$ZP_CREDENTIAL_DIR/cloudflared.json"
  printf -v "$result_variable" '%s' "$created_tunnel_id"
}

write_xray_config() {
  local reality_sni=$1 vless_port=$2 hy2_port=$3 uuid private_key short_id ws_path hy2_password listen_address
  uuid=$(read_secret "vless.uuid")
  private_key=$(read_secret "reality.private-key")
  short_id=$(read_secret "reality.short-id")
  ws_path=$(read_secret "ws.path")
  hy2_password=$(read_secret "hysteria.password")
  listen_address=$(inbound_listen_address)

  jq -n \
    --arg reality_sni "$reality_sni" \
    --arg uuid "$uuid" \
    --arg private_key "$private_key" \
    --arg short_id "$short_id" \
    --arg ws_path "$ws_path" \
    --arg hy2_password "$hy2_password" \
    --arg listen_address "$listen_address" \
    --arg cert_file "$ZP_TLS_DIR/fullchain.pem" \
    --arg key_file "$ZP_TLS_DIR/privkey.pem" \
    --argjson vless_port "$vless_port" \
    --argjson hy2_port "$hy2_port" \
    '{
      log:{loglevel:"warning"},
      inbounds:[
        {
          tag:"vless-reality-direct",listen:$listen_address,port:$vless_port,protocol:"vless",
          settings:{clients:[{id:$uuid,flow:"xtls-rprx-vision"}],decryption:"none"},
          streamSettings:{
            network:"raw",security:"reality",
            realitySettings:{
              target:($reality_sni + ":443"),serverNames:[$reality_sni],
              privateKey:$private_key,shortIds:[$short_id]
            }
          },
          sniffing:{enabled:true,destOverride:["http","tls","quic"],metadataOnly:false}
        },
        {
          tag:"hysteria2-direct",listen:$listen_address,port:$hy2_port,protocol:"hysteria",
          settings:{version:2,clients:[{auth:$hy2_password}]},
          streamSettings:{
            network:"hysteria",security:"tls",
            tlsSettings:{
              alpn:["h3"],
              certificates:[{certificateFile:$cert_file,keyFile:$key_file}]
            }
          },
          sniffing:{enabled:true,destOverride:["http","tls","quic"],metadataOnly:false}
        },
        {
          tag:"vless-ws-cloudflare",listen:"127.0.0.1",port:17122,protocol:"vless",
          settings:{clients:[{id:$uuid}],decryption:"none"},
          streamSettings:{network:"ws",security:"none",wsSettings:{path:$ws_path}},
          sniffing:{enabled:true,destOverride:["http","tls"],metadataOnly:false}
        }
      ],
      outbounds:[
        {tag:"direct",protocol:"freedom",settings:{domainStrategy:"UseIP"}},
        {tag:"blocked",protocol:"blackhole"}
      ]
    }' >"$ZP_CONFIG_DIR/xray.tmp.json"
  chown root:zenproxy-xray "$ZP_CONFIG_DIR/xray.tmp.json"
  chmod 0640 "$ZP_CONFIG_DIR/xray.tmp.json"
  "$XRAY_BIN" run -test -config "$ZP_CONFIG_DIR/xray.tmp.json"
  mv "$ZP_CONFIG_DIR/xray.tmp.json" "$ZP_CONFIG_DIR/xray.json"
}

