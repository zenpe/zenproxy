  [[ -z "$VLESS_V4_LINK" ]] || printf '\n[VLESS REALITY直连 IPv4]\n%s\n' "$VLESS_V4_LINK"
  [[ -z "$HY2_V6_LINK" ]] || printf '\n[HY2直连 IPv6]\n%s\n' "$HY2_V6_LINK"
  [[ -z "$VLESS_V6_LINK" ]] || printf '\n[VLESS REALITY直连 IPv6]\n%s\n' "$VLESS_V6_LINK"
  if [[ -t 1 ]]; then
    print_qr "Cloudflare主线路二维码" "$CF_LINK"
