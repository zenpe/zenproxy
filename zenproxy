    [[ -z "$VLESS_V4_LINK" ]] || print_qr "VLESS REALITY直连 IPv4二维码" "$VLESS_V4_LINK"
    [[ -z "$HY2_V6_LINK" ]] || print_qr "HY2直连 IPv6二维码" "$HY2_V6_LINK"
    [[ -z "$VLESS_V6_LINK" ]] || print_qr "VLESS REALITY直连 IPv6二维码" "$VLESS_V6_LINK"
  fi
